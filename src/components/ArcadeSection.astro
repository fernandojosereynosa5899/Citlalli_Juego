  }

  /* Consola Chiptune 8-Bit */
  .track-now-playing {
    background: rgba(6, 11, 24, 0.85);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 12px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 0.75rem;
  }

  .track-now-playing strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--gold-bright);
  }

  .track-now-playing small {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .visualizer-header-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .visualizer-header-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--gold-bright);
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.45);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.25);
    text-transform: uppercase;
  }

  .eq-bars-container,
  .audio-visualizer-bars {
    height: 50px;
    background: rgba(4, 7, 16, 0.95);
    border: 1.5px solid rgba(212, 175, 55, 0.35);
    border-radius: 12px;
    padding: 6px 10px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4px;
    margin-bottom: 0.85rem;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.7), 0 0 16px rgba(212, 175, 55, 0.15);
    position: relative;
    overflow: hidden;
  }

  .eq-bar,
  .audio-visualizer-bar {
    flex: 1;
    min-width: 4px;
    height: 20%;
    background: linear-gradient(180deg, var(--gold-bright) 0%, var(--rose-gold) 60%, var(--gold-metallic) 100%);
    border-radius: 4px 4px 0 0;
    transition: height 0.08s ease;
    box-shadow: 0 0 6px rgba(212, 175, 55, 0.35);
  }

  /* Animación CSS de ondas suaves (idle dancing pulse) cuando el audio está pausado o en reposo */
  .eq-bars-container.is-idle .eq-bar,
  .audio-visualizer-bars.is-idle .audio-visualizer-bar,
  .eq-bars-container:not(.is-playing) .eq-bar {
    animation: eqIdlePulse 1.9s ease-in-out infinite alternate;
    animation-delay: calc(var(--i, 0) * 0.11s);
  }

  @keyframes eqIdlePulse {
    0% {
      height: 16%;
      opacity: 0.45;
      background: linear-gradient(180deg, var(--gold-metallic) 0%, #8c6721 100%);
    }
    50% {
      height: 58%;
      opacity: 0.9;
      background: linear-gradient(180deg, var(--gold-bright) 0%, var(--rose-gold) 70%, var(--gold-metallic) 100%);
    }
    100% {
      height: 26%;
      opacity: 0.6;
      background: linear-gradient(180deg, var(--rose-bright) 0%, var(--rose-gold) 100%);
    }
  }

  .audio-controls-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.45rem;
    margin-bottom: 0.75rem;
  }

  .btn-audio-ctrl {
