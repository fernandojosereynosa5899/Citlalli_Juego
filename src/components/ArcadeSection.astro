---
/**
 * CITLALLI — ArcadeSection.astro
 * Gabinete Arcade Pixel Art de Lujo (4 Juegos Modulares + Modo Torneo Copa Citlalli),
 * Selector de 4 Escenarios, Consola Chiptune de 16 Bandas, Sala Multijugador Simultánea,
 * Tabla de Récords, Generador de Tarjeta de Trofeo PNG (1080x600) y Constelación de 12 Logros.
 */
---

<section id="arcade-salon" class="arcade-section">
  <div class="section-container">
    <!-- Encabezado del Salón Arcade -->
    <div class="section-header">
      <span class="section-kicker">
        <span>🕹️</span> SALÓN ARCADE PIXEL ART • 4 JUEGOS MODULARES + MULTIJUGADOR SIMULTÁNEO
      </span>
      <h2 class="section-title">
        El Gabinete <span class="gold-accent">CITLALLI Arcade</span> & <span class="gold-accent">Copa 1ZMEADMLSA</span>
      </h2>
      <p class="section-subtitle">
        Cuatro experiencias independientes inspiradas en el universo de CITLALLI. Cambia de
        escenario en tiempo real, compite a 2 jugadores o en sala multijugador y descarga tu
        Certificado de Récord Estelar en PNG.
      </p>
    </div>

    <!-- Banner de Desafío Activo por URL (?challenge=...) -->
    <div id="arcade-challenge-banner" class="challenge-banner hidden">
      <div class="challenge-banner-left">
        <span class="challenge-bolt">⚡</span>
        <div>
          <strong id="challenge-banner-title">
            DESAFÍO ACTIVO: Supera los 450 PTS de Fernando
          </strong>
          <p id="challenge-banner-sub">
            Juega ahora y supera la marca objetivo para conquistar la insignia de Embajador Estelar.
          </p>
        </div>
      </div>
      <div class="challenge-progress-wrap">
        <div class="challenge-progress-labels">
          <span id="challenge-current-pts">Tu Puntaje: 0 PTS</span>
          <span id="challenge-target-pts">Meta: 450 PTS</span>
        </div>
        <div class="challenge-progress-track">
          <div id="challenge-progress-fill" class="challenge-progress-fill" style="width: 0%"></div>
        </div>
      </div>
      <button type="button" id="challenge-dismiss-btn" class="btn-challenge-close" title="Cerrar aviso">
        ✕
      </button>
    </div>

    <!-- Banner de Progreso del Modo Torneo: Copa Citlalli (4 Juegos Encadenados) -->
    <div id="arcade-tournament-banner" class="tournament-banner hidden">
      <div class="tourney-header-row">
        <div>
          <span class="tourney-kicker">🏆 CAMPEONATO OFICIAL EN CURSO • GRUPO 1ZMEADMLSA</span>
          <h4>Copa Citlalli: Los 4 Desafíos de los Dioses</h4>
        </div>
        <div class="tourney-total-box">
          <span>PUNTAJE ACUMULADO</span>
          <strong id="tourney-total-score">0 PTS</strong>
        </div>
      </div>

      <div class="tourney-stages-grid" id="tourney-stages-grid">
        <div class="tourney-stage-pill active" data-tourney-step="snake">
          <span>1. 🐍 Víborita</span>
          <strong id="tourney-score-snake">0 pts</strong>
        </div>
        <div class="tourney-stage-pill" data-tourney-step="memory">
          <span>2. 🃏 Memorama</span>
          <strong id="tourney-score-memory">0 pts</strong>
        </div>
        <div class="tourney-stage-pill" data-tourney-step="reflex">
          <span>3. ⚡ Reflejos</span>
          <strong id="tourney-score-reflex">0 pts</strong>
        </div>
        <div class="tourney-stage-pill" data-tourney-step="flappy">
          <span>4. 🦅 Flappy Citlalli</span>
          <strong id="tourney-score-flappy">0 pts</strong>
        </div>
      </div>

      <div class="tourney-actions-row">
        <p id="tourney-status-text">
          Etapa 1 de 4: Termina tu partida para registrar el puntaje y avanzar automáticamente al
          siguiente juego.
        </p>
        <div class="tourney-btns">
          <button type="button" id="btn-tourney-next" class="btn-tourney-step">
            Siguiente Etapa ➔
          </button>
          <button type="button" id="btn-tourney-cancel" class="btn-tourney-exit">
            Salir del Torneo
          </button>
        </div>
      </div>
    </div>

    <!-- =================================================================== -->
    <!-- SELECTOR DE LOS 4 JUEGOS MODULARES + MODO TORNEO                    -->
    <!-- =================================================================== -->
    <div class="games-selector-bar" role="tablist" aria-label="Selector de Juegos Citlalli">
      <button
        type="button"
        class="game-tab-card active"
        data-game-select="snake"
        role="tab"
        aria-selected="true"
      >
        <span class="game-tab-icon">🐍</span>
        <div class="game-tab-info">
          <span class="game-tab-num">JUEGO 01</span>
          <strong>La Víborita: Estela de los Dioses</strong>
          <small>Recolecta las 5 notas olfativas y el Frasco QM</small>
        </div>
      </button>

      <button
        type="button"
        class="game-tab-card"
        data-game-select="memory"
        role="tab"
        aria-selected="false"
      >
        <span class="game-tab-icon">🃏</span>
        <div class="game-tab-info">
          <span class="game-tab-num">JUEGO 02</span>
          <strong>Memorama: Memoria Olfativa</strong>
          <small>10 pares de lujo + Poder Brisa de Hidalgo</small>
        </div>
      </button>

      <button
        type="button"
        class="game-tab-card"
        data-game-select="reflex"
        role="tab"
        aria-selected="false"
      >
        <span class="game-tab-icon">⚡</span>
        <div class="game-tab-info">
          <span class="game-tab-num">JUEGO 03</span>
          <strong>Reflejos: Destilación & Duelo ms</strong>
          <small>Atrapa esencias o compite en reacción pura</small>
        </div>
      </button>

      <button
        type="button"
        class="game-tab-card"
        data-game-select="flappy"
        role="tab"
        aria-selected="false"
      >
        <span class="game-tab-icon">🦅</span>
        <div class="game-tab-info">
          <span class="game-tab-num">JUEGO 04</span>
          <strong>Flappy Citlalli: El Límite son las Estrellas</strong>
          <small>Vuela con el Frasco Alado entre columnas de jaguar</small>
        </div>
      </button>

      <button
        type="button"
        class="game-tab-card tourney-card"
        id="btn-start-copa-citlalli"
        data-game-select="tournament"
      >
        <span class="game-tab-icon">🏆</span>
        <div class="game-tab-info">
          <span class="game-tab-num">MODO CAMPEONATO</span>
          <strong>Copa Citlalli (4 Juegos)</strong>
          <small>Encadena los 4 juegos y gana el Gran Trofeo</small>
        </div>
      </button>
    </div>

    <!-- =================================================================== -->
    <!-- CUERPO DEL GABINETE ARCADE + PANELES LATERALES                      -->
    <!-- =================================================================== -->
    <div class="arcade-workspace-grid">
      <!-- COLUMNA CENTRAL / IZQUIERDA: EL GABINETE ARCADE PIXEL ART -->
      <div class="arcade-cabinet-shell">
        <!-- Marquesina Iluminada Superior -->
        <div class="cabinet-marquee">
          <img
            src="/assets/pixel-art/citlalli_arcade_marquee.png"
            alt="CITLALLI Arcade Marquee Oficial"
            class="marquee-img"
          />
          <div class="marquee-overlay">
            <div class="marquee-title-wrap">
              <span class="marquee-kicker">CITLALLI PARFUMS • OFFICIAL 8-BIT CABINET</span>
              <h3 id="cabinet-active-game-title">🐍 La Víborita: Estela de los Dioses</h3>
            </div>
            <div class="marquee-badges">
              <span id="cabinet-active-scenario-pill" class="marquee-pill">
                🌌 Hidalgo Estelar
              </span>
              <span id="cabinet-active-mode-pill" class="marquee-pill pill-gold">
                👤 1 Jugador
              </span>
            </div>
          </div>
        </div>

        <!-- Barra de Configuración Rápida: Modo Simultáneo, Dificultad y Submodo -->
        <div class="cabinet-controls-strip">
          <div class="control-group">
            <label for="arcade-mode-select">MODO DE JUEGO SIMULTÁNEO</label>
            <select id="arcade-mode-select" class="arcade-select">
              <option value="1p">👤 1 Jugador (Récord Individual)</option>
              <option value="2p_local">👥 2 Jugadores Simultáneos (Mismo Teclado)</option>
              <option value="vs_ai">🤖 Duelo vs IA “Sombra del Jaguar”</option>
              <option value="online">🌐 Sala Multijugador en Vivo (Pestañas/Red)</option>
            </select>
          </div>

          <div class="control-group">
            <label for="arcade-difficulty-select">VELOCIDAD / DIFICULTAD</label>
            <select id="arcade-difficulty-select" class="arcade-select">
              <option value="normal">🌱 Brisa de Hidalgo (Normal)</option>
              <option value="fast">✨ Noche de Gala (Rápido)</option>
              <option value="god">👑 Fuerza de los Dioses (Experto)</option>
            </select>
          </div>

          <div class="control-group actions-inline">
            <button type="button" id="btn-arcade-start" class="btn-cab-action btn-cab-gold">
              ▶ Iniciar / Reiniciar
            </button>
            <button type="button" id="btn-arcade-pause" class="btn-cab-action">
              ⏸ Pausa
            </button>
            <button
              type="button"
              id="btn-reflex-submode"
              class="btn-cab-action hidden"
              title="Alternar entre Modo Destilación de Orbes y Duelo Relámpago de 5 Rondas"
            >
              ⚡ Cambiar Duelo/Orbes
            </button>
          </div>
        </div>

        <!-- HUD Superior en Vivo: Marcadores J1, J2/Rival, Rango Místico y Carrera en Vivo -->
        <div class="cabinet-live-hud">
          <div class="hud-stat-box">
            <span class="hud-label">JUGADOR 1 (TÚ)</span>
            <strong id="hud-p1-score" class="hud-score-val">0 PTS</strong>
          </div>

          <div class="hud-stat-box">
            <span class="hud-label" id="hud-p2-label">RIVAL / RÉCORD</span>
            <strong id="hud-p2-score" class="hud-score-val rose-val">0 PTS</strong>
          </div>

          <div class="hud-stat-box">
            <span class="hud-label">RACHA / COMBO</span>
            <strong id="hud-combo-val" class="hud-combo-val">x1</strong>
          </div>

          <div class="hud-stat-box rank-box">
            <span class="hud-label">RANGO MÍSTICO ACTUAL</span>
            <strong id="hud-mystic-rank" class="hud-rank-val">🌱 Aprendiz de Hidalgo</strong>
          </div>
        </div>

        <!-- Barra de Carrera Multijugador Simultánea en Vivo -->
        <div class="live-race-tracker" id="live-race-tracker">
          <div class="race-header">
            <span>🏁 CARRERA MULTIJUGADOR EN TIEMPO REAL (SALA <strong id="race-room-code">CITLALLI-01</strong>)</span>
            <span id="race-leader-label">Líder: David (Hidalgo)</span>
          </div>
          <div id="live-race-bars" class="race-bars-list"></div>
        </div>

        <!-- Marco de Pantalla CRT / Monitor Pixel Art -->
        <div id="arcade-screen-viewport" class="arcade-screen-viewport crt-enabled">
          <canvas
            id="citlalli-arcade-canvas"
            width="800"
            height="534"
            aria-label="Pantalla de Juego CITLALLI Arcade"
          ></canvas>

          <!-- Capa de Emotes Flotantes en Vivo -->
          <div id="arcade-emote-layer" class="arcade-emote-layer" aria-hidden="true"></div>

          <!-- Scanlines CRT decorativas -->
          <div class="crt-scanlines" aria-hidden="true"></div>
        </div>

        <!-- Barra de Controles del Jugador + Botón de Trofeo y Desafío -->
        <div class="cabinet-bottom-bar">
          <div class="controls-legend" id="arcade-controls-legend">
            <span><strong>J1:</strong> WASD / Flechas / Clic</span>
            <span><strong>J2 Local:</strong> Flechas / IJKL / Clic Der</span>
            <span><strong>Pausa:</strong> Tecla P</span>
          </div>

          <div class="postgame-quick-btns">
            <button type="button" id="btn-open-trophy-modal" class="btn-Share-trophy">
              🏅 Tarjeta de Trofeo PNG
            </button>
            <button type="button" id="btn-copy-challenge-link" class="btn-share-challenge">
              🔗 Crear Link de Desafío
            </button>
          </div>
        </div>

        <!-- Cruceta Táctil (D-Pad Pixel Art) para Móvil y Ratón -->
        <div class="touch-dpad-deck">
          <div class="dpad-cross">
            <button type="button" class="dpad-btn dpad-up" data-dpad="up" aria-label="Arriba">
              ▲
            </button>
            <div class="dpad-mid-row">
              <button type="button" class="dpad-btn dpad-left" data-dpad="left" aria-label="Izquierda">
                ◀
              </button>
              <div class="dpad-center-gem">✦</div>
              <button type="button" class="dpad-btn dpad-right" data-dpad="right" aria-label="Derecha">
                ▶
              </button>
            </div>
            <button type="button" class="dpad-btn dpad-down" data-dpad="down" aria-label="Abajo">
              ▼
            </button>
          </div>

          <div class="dpad-action-cluster">
            <button type="button" class="action-arcade-btn btn-act-a" data-dpad="action">
              <span>★</span>
              <small>ACCIÓN / ALETEO</small>
            </button>
            <button type="button" class="action-arcade-btn btn-act-b" id="btn-dpad-spray">
              <span>🧴</span>
              <small>BRISA / ROCÍO</small>
            </button>
          </div>
        </div>

        <!-- Selector en Vivo de los 4 Escenarios Pixel Art -->
        <div class="scenarios-strip-box">
          <div class="scenarios-strip-header">
            <span>🌌 CAMBIAR ESCENARIO PIXEL ART Y PISTA CHIPTUNE EN VIVO</span>
            <small>Se aplica al instante sin perder tu partida</small>
          </div>
          <div class="scenarios-cards-row">
            <button
              type="button"
              class="scenario-card-btn active"
              data-scenario-btn="hidalgo"
            >
              <img
                src="/assets/pixel-art/scenarios/scenario_hidalgo.png"
                alt="Noche Estrellada en Hidalgo"
                loading="lazy"
              />
              <div>
                <strong>1. Hidalgo Estelar</strong>
                <small>Árbol de David & Nubes</small>
              </div>
            </button>

            <button
              type="button"
              class="scenario-card-btn"
              data-scenario-btn="jaguar"
            >
              <img
                src="/assets/pixel-art/scenarios/scenario_jaguar.png"
                alt="Santuario del Jaguar Dorado"
                loading="lazy"
              />
              <div>
                <strong>2. Templo Jaguar</strong>
                <small>Pirámide & Ámbar</small>
              </div>
            </button>

            <button
              type="button"
              class="scenario-card-btn"
              data-scenario-btn="velvet"
            >
              <img
                src="/assets/pixel-art/scenarios/scenario_velvet.png"
                alt="Cámara Alquímica de Terciopelo"
                loading="lazy"
              />
              <div>
                <strong>3. Cámara Terciopelo</strong>
                <small>Oro Rosa & Dije QM</small>
              </div>
            </button>

            <button
              type="button"
              class="scenario-card-btn"
              data-scenario-btn="penthouse"
            >
              <img
                src="/assets/pixel-art/scenarios/scenario_penthouse.png"
                alt="Penthouse Nocturno"
                loading="lazy"
              />
              <div>
                <strong>4. Penthouse Citlalli</strong>
                <small>Gala Metropolitana</small>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- COLUMNA DERECHA: AUDIO CHIPTUNE, SALA MULTIJUGADOR Y LORE EN VIVO -->
      <aside class="arcade-sidebar">
        <!-- 1. Consola de Audio Chiptune 8-Bit & VFX -->
        <div class="sidebar-card audio-console-card">
          <div class="sidebar-card-header">
            <span>🎵 SINTETIZADOR CHIPTUNE 8-BIT</span>
            <span id="audio-bpm-badge" class="mini-gold-pill">112 BPM</span>
          </div>

          <div class="track-now-playing">
            <strong id="audio-track-title">Noche Estrellada en Hidalgo</strong>
            <small id="audio-track-subtitle">El Sueño de David bajo el Árbol Ancestral</small>
          </div>

          <!-- Ecualizador de 16 Barras en Vivo -->
          <div class="eq-bars-container" id="arcade-eq-bars" aria-hidden="true">
            {Array.from({ length: 16 }).map(() => (
              <div class="eq-bar" style="height: 18%"></div>
            ))}
          </div>

          <div class="audio-controls-grid">
            <button type="button" id="btn-audio-toggle" class="btn-audio-ctrl active">
              ▶ Música 8-Bit
            </button>
            <button type="button" id="btn-audio-mute" class="btn-audio-ctrl">
              🔊 Sonido Activo
            </button>
            <button type="button" id="btn-audio-sfx-test" class="btn-audio-ctrl">
              ✨ Spray SFX
            </button>
            <button type="button" id="btn-crt-toggle" class="btn-audio-ctrl active">
              📺 Filtro CRT
            </button>
            <button type="button" id="btn-fullscreen-toggle" class="btn-audio-ctrl" title="Pantalla Completa (Tecla F)">
              ⛶ Pantalla Completa
            </button>
          </div>

          <div class="audio-volume-row" style="margin-top: 0.75rem; display: flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; color: #D4AF37; font-family: 'Cinzel', serif;">
            <label for="arcade-volume-slider">VOLUMEN:</label>
            <input type="range" id="arcade-volume-slider" min="0" max="100" value="80" style="flex: 1; accent-color: #D4AF37; cursor: pointer;" />
            <span id="arcade-volume-label" style="min-width: 36px; text-align: right; font-weight: bold; color: #FFE57F;">80%</span>
          </div>
        </div>

        <!-- 2. Sala Multijugador Simultánea en Tiempo Real -->
        <div class="sidebar-card multiplayer-room-card">
          <div class="sidebar-card-header">
            <span>🌐 SALA MULTIJUGADOR EN VIVO</span>
            <span class="online-dot-badge">● SINCRONIZADO</span>
          </div>

          <!-- Perfil del Jugador -->
          <div class="mp-profile-form">
            <div class="mp-field">
              <label for="mp-player-name">TU NOMBRE DE ALQUIMISTA</label>
              <input
                type="text"
                id="mp-player-name"
                maxlength="20"
                placeholder="Ej. David de Hidalgo"
                value="Viajero Estelar"
              />
            </div>

            <div class="mp-field">
              <label>TU AVATAR PIXEL ART</label>
              <div class="avatar-picker-row" id="mp-avatar-picker">
                <button
                  type="button"
                  class="avatar-pick-btn active"
                  data-avatar-id="bottle"
                  title="Frasco Citlalli"
                >
                  <img src="/assets/pixel-art/sprites/bottle_citlalli.png" alt="Frasco" width="28" height="28" />
                </button>
                <button
                  type="button"
                  class="avatar-pick-btn"
                  data-avatar-id="jaguar"
                  title="Jaguar Dorado"
                >
                  <img src="/assets/pixel-art/sprites/jaguar_gold.png" alt="Jaguar" width="28" height="28" />
                </button>
                <button
                  type="button"
                  class="avatar-pick-btn"
                  data-avatar-id="star"
                  title="Estrella Citlalli"
                >
                  <img src="/assets/pixel-art/sprites/star_citlalli.png" alt="Estrella" width="28" height="28" />
                </button>
                <button
                  type="button"
                  class="avatar-pick-btn"
                  data-avatar-id="charm_qm"
                  title="Medallón QM"
                >
                  <img src="/assets/pixel-art/sprites/charm_qm.png" alt="Dije QM" width="28" height="28" />
                </button>
              </div>
            </div>

            <!-- Código de Sala -->
            <div class="mp-room-row">
              <div class="mp-room-input-wrap">
                <label for="mp-room-code-input">CÓDIGO DE SALA</label>
                <input
                  type="text"
                  id="mp-room-code-input"
                  value="CITLALLI-01"
                  maxlength="16"
                />
              </div>
              <button type="button" id="btn-mp-join-room" class="btn-mp-join">
                Unirse
              </button>
              <button
                type="button"
                id="btn-mp-random-room"
                class="btn-mp-random"
                title="Generar nuevo código místico"
              >
                🎲
              </button>
            </div>

            <label class="mp-bots-toggle">
              <input type="checkbox" id="mp-bots-checkbox" checked />
              <span>Incluir rivales IA en vivo en la sala</span>
            </label>
          </div>

          <!-- Lista de Jugadores Conectados en Vivo -->
          <div class="mp-players-list-wrap">
            <div class="mp-list-header">
              <span>JUGADORES EN SALA</span>
              <small>Abre otra pestaña para duelo multicámara</small>
            </div>
            <div id="mp-connected-players" class="mp-connected-list"></div>
          </div>

          <!-- Botonera de Emotes Pixel Art en Vivo -->
          <div class="mp-emotes-bar">
            <span class="mp-emotes-label">LANZAR EMOTE A LA SALA:</span>
            <div class="mp-emotes-btns">
              <button type="button" class="btn-emote" data-emote="aroma" title="¡Aroma de los Dioses!">
                🧴 Aroma
              </button>
              <button type="button" class="btn-emote" data-emote="jaguar" title="¡Fuerza del Jaguar!">
                🐆 Jaguar
              </button>
              <button type="button" class="btn-emote" data-emote="stars" title="¡El límite son las estrellas!">
                ⭐ Estrellas
              </button>
              <button type="button" class="btn-emote" data-emote="streak" title="¡Racha Dorada!">
                🔥 Racha
              </button>
            </div>
          </div>
        </div>

        <!-- 3. Códice Olfativo & Lore Desbloqueado en Vivo -->
        <div class="sidebar-card lore-codex-card">
          <div class="sidebar-card-header">
            <span>📜 CÓDICE OLFATIVO EN VIVO</span>
            <span class="mini-gold-pill">ENCICLOPEDIA</span>
          </div>

          <div class="lore-active-display" id="lore-active-display">
            <img
              id="lore-active-sprite"
              src="/assets/pixel-art/sprites/bottle_citlalli.png"
              alt="Reliquia Citlalli"
              width="48"
              height="48"
            />
            <div>
              <span id="lore-active-category" class="lore-cat-tag">Reliquia Suprema</span>
              <h4 id="lore-active-name">Frasco Facetado Citlalli</h4>
              <p id="lore-active-desc">
                Cristal facetado con tapa cilíndrica oro rosa y el sello de los dioses (50 ml Eau de
                Parfum). Recolecta ingredientes en el Arcade para inspeccionar su historia.
              </p>
            </div>
          </div>

          <div class="lore-mini-sprites-bar" id="lore-mini-sprites-bar">
            <button type="button" class="lore-sprite-btn" data-lore-id="bottle_citlalli" title="Frasco Citlalli">
