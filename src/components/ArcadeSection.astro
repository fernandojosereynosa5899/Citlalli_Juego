    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    transition: color 0.2s ease;
  }

  .arcade-modal-close:hover {
    color: var(--gold-bright);
  }

  .arcade-modal-body {
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .profile-hero-preview {
    display: flex;
