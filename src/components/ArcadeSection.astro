  /* Modal de Selección de Avatar Pixel Art y Nombre del Jugador */
  .arcade-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(3, 6, 16, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    animation: modalOverlayFade 0.25s ease-out;
  }

  @keyframes modalOverlayFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .arcade-modal-card {
    background: linear-gradient(165deg, #0e1736 0%, #060b1c 100%);
    border: 2px solid var(--gold-bright);
    border-radius: 22px;
    width: 100%;
    max-width: 620px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.85), 0 0 40px rgba(212, 175, 55, 0.25);
    display: flex;
    flex-direction: column;
    animation: modalScaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalScaleUp {
    from { transform: scale(0.92) translateY(12px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .arcade-modal-header {
    display: flex;
    justify-content: space-between;
