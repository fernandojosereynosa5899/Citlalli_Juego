---
/**
 * CITLALLI — ArcadeSection.astro
 * Salón de Minijuegos Pixel Art a 60 FPS con Alta Usabilidad y Ergonomía
 *
 * Características mejoradas:
 * - Renderizado a 60 FPS mediante requestAnimationFrame con delta-time y física suave
 * - 4 Minijuegos Pixel Art en Canvas HTML5 Puro (Snake, Flappy Bird, Memorama, Reflejos)
 * - 5 Mapas Mesoamericanos: Selva de Jade, Pirámide Solar, Espacio Citlalli, Maizal Sagrado, Cenote Sagrado
 * - Soporte de audio sintético Web Audio API con interruptor (🔊 / 🔇)
 * - Modo Pantalla Completa (⛶) y sistema de Pausa (⏸ / P / Esc)
 * - Detección táctil con gestos swipe y vibración háptica en celulares
 * - HUD con puntaje actual y récord personal en tiempo real
 * - Carrusel 3D con navegación interactiva por teclado (◀ ▶ / Enter), ratón y gestos táctiles
 * - Sincronizado en tiempo real con la Base de Datos volátil en memoria RAM (/api/records)
 * - Solo utiliza recursos locales de la carpeta de Citlalli
 */
---

<section id="arcade-salon" class="arcade-section" aria-label="Salón Arcade de Minijuegos Citlalli">
  <!-- Capa de partículas de transición aromática -->
  <div class="transition-fx-layer" id="arcade-fx-layer"></div>

  <div class="arcade-container" id="arcade-cabinet-container">
    <!-- Barra Superior del Arcade -->
    <header class="arcade-topbar">
      <div class="arcade-brand-pill">
        <span class="qm-tag">QM</span>
        <span class="brand-text">CITLALLI · MULTIGAMES 60 FPS</span>
      </div>

      <div class="arcade-topbar-right">
        <!-- Interruptor de Audio Chiptune -->
        <button
          type="button"
          class="btn-pixel btn-audio-toggle"
          id="btn-toggle-audio"
          title="Activar o silenciar efectos de sonido"
          aria-label="Alternar sonido"
        >
          <span id="audio-icon">🔊</span> <span id="audio-label">Audio: ON</span>
        </button>

        <!-- Botón Pantalla Completa -->
        <button
          type="button"
          class="btn-pixel btn-fullscreen-toggle"
          id="btn-toggle-fullscreen"
          title="Modo pantalla completa (Tecla F)"
          aria-label="Alternar pantalla completa"
        >
          ⛶ Pantalla Completa
        </button>

        <!-- Indicador de Jugador Activo (Click para cambiar nombre/avatar) -->
        <button
          type="button"
          class="user-pill-btn"
          id="btn-edit-user"
          title="Haz clic para cambiar tu nombre y avatar"
        >
          <span class="user-avatar-mini" id="user-avatar-mini">🧴</span>
          <span id="user-indicator-text">JUGADOR: FERNANDO</span>
          <span class="user-edit-hint">✎</span>
        </button>

        <!-- Botón Volver al Menú de Juegos (Visible solo en partida) -->
        <button
          class="btn-pixel btn-back-menu"
          id="btn-volver-menu"
          style="display: none;"
          type="button"
        >
          ⬅ Menú de Juegos
        </button>

        <!-- Botón Salón de Récords -->
        <button class="btn-pixel btn-topbar-records" id="btn-topbar-records" type="button">
          🏆 Récords & Premios
        </button>
      </div>
    </header>

    <!-- Contenedor Principal de Pantalla (Renderizado Dinámico del Carrusel y Minijuegos) -->
    <main class="arcade-screen anim-screen-enter" id="arcade-screen">
      <div class="arcade-loading-state">
        <span class="loading-spinner">✦</span>
        <p>Iniciando Salón Arcade CITLALLI a 60 FPS...</p>
      </div>
    </main>

    <!-- Barra de atajos de teclado y ergonomía -->
    <footer class="arcade-bottom-hints">
      <div class="shortcuts-row">
        <span class="hint-pill"><span>◀ ▶</span> Girar Carrusel / Moverse</span>
        <span class="hint-pill"><span>ENTER</span> Jugar / Reintentar</span>
        <span class="hint-pill"><span>ESPACIO</span> Saltar / Volar</span>
        <span class="hint-pill"><span>P</span> Pausar</span>
        <span class="hint-pill"><span>F</span> Pantalla Completa</span>
        <span class="hint-pill"><span>M</span> Silenciar</span>
      </div>
    </footer>
  </div>

  <!-- Botón Fijo Inferior Izquierdo "🏆 Récords #1" -->
  <button class="btn-record-fixed" id="btn-open-records" type="button" aria-label="Abrir tabla de récords">
    🏆 Récords #1
  </button>

  <!-- Modal de Récords en Red Local y Premios -->
  <div class="records-modal-backdrop" id="records-backdrop" aria-hidden="true">
    <section class="records-modal" role="dialog" aria-modal="true" aria-label="Tabla de Récords y Premios Citlalli">
      <div class="records-header">
        <div class="records-title-group">
          <h2>🏆 TABLA DE RÉCORDS · PREMIOS AL #1</h2>
          <span class="records-badge-db">🟢 Base de Datos en RAM Activa</span>
        </div>
        <div class="records-actions">
          <button class="btn-pixel" id="btn-copy-records" type="button" title="Copiar resumen de récords">
            📋 Copiar
          </button>
          <button class="btn-pixel" id="btn-refresh-records" type="button">
            ↻ Sincronizar
          </button>
          <button class="btn-pixel btn-close-modal" id="btn-close-records" type="button" aria-label="Cerrar ventana">
            ✕ Cerrar
          </button>
        </div>
      </div>

      <!-- Barra de Estado de Sincronización -->
      <div class="lan-bar">
        <div class="lan-status-left">
          <span class="lan-status-dot"></span>
          <strong id="lan-status-text">
            Sincronizado con Base de Datos en Memoria RAM (/api/records)
          </strong>
        </div>
        <div class="lan-status-right">
          <span>Actualización en tiempo real con 60 FPS</span>
        </div>
      </div>

      <!-- Cuadrícula de los 4 Juegos -->
      <div class="records-grid" id="records-grid-container">
        <!-- Renderizado dinámicamente -->
      </div>
    </section>
  </div>

  <!-- Modal de Edición de Jugador y Selección de Avatar -->
  <div class="user-modal-backdrop" id="user-modal-backdrop" aria-hidden="true">
    <section class="user-modal" role="dialog" aria-modal="true" aria-label="Perfil del Jugador">
      <div class="records-header">
        <h2>👤 PERFIL DEL JUGADOR</h2>
        <button class="btn-pixel btn-close-modal" id="btn-close-user-modal" type="button" aria-label="Cerrar ventana">
          ✕
        </button>
      </div>

      <form id="form-edit-user" class="user-edit-form">
        <label for="input-edit-username" class="user-input-label">
          TU NOMBRE O ALIAS PARA LA TABLA DE RÉCORDS:
        </label>
        <input
          type="text"
          id="input-edit-username"
          class="pixel-input"
          maxlength="18"
          placeholder="Escribe tu nombre..."
          autocomplete="off"
          required
        />

        <div class="avatar-selection-box">
          <span class="avatar-selection-title">SELECCIONA TU AVATAR OFICIAL CITLALLI:</span>
          <div class="avatars-grid" id="avatars-grid">
            <button type="button" class="avatar-option active" data-avatar="bottle" data-emoji="🧴">
              <span class="av-emoji">🧴</span>
              <span class="av-name">Frasco Citlalli</span>
            </button>
            <button type="button" class="avatar-option" data-avatar="charm_qm" data-emoji="🪙">
              <span class="av-emoji">🪙</span>
              <span class="av-name">Medallón QM</span>
            </button>
            <button type="button" class="avatar-option" data-avatar="jaguar" data-emoji="🐆">
              <span class="av-emoji">🐆</span>
              <span class="av-name">Jaguar Dorado</span>
            </button>
            <button type="button" class="avatar-option" data-avatar="star" data-emoji="⭐">
              <span class="av-emoji">⭐</span>
              <span class="av-name">Estrella Citlalli</span>
            </button>
            <button type="button" class="avatar-option" data-avatar="rose" data-emoji="🌹">
              <span class="av-emoji">🌹</span>
              <span class="av-name">Rosa Rosada</span>
            </button>
            <button type="button" class="avatar-option" data-avatar="amber" data-emoji="💎">
              <span class="av-emoji">💎</span>
              <span class="av-name">Ámbar Dorado</span>
            </button>
          </div>
        </div>

        <div class="user-modal-footer">
          <button type="submit" class="btn-primary-pixel">
            GUARDAR PERFIL ▶
          </button>
        </div>
      </form>
    </section>
  </div>
</section>

<style>
  /* ==========================================================================
     ESTILOS SALÓN ARCADE 60 FPS — CITLALLI
     ========================================================================== */
  .arcade-section {
    position: relative;
    width: 100%;
    min-height: 840px;
    background: radial-gradient(circle at 50% 20%, rgba(20, 32, 60, 0.96) 0%, rgba(10, 17, 36, 0.99) 100%);
    color: var(--cream-silk, #F6EFE6);
    padding: 1.5rem 0 3.5rem;
    overflow-x: hidden;
  }

  .arcade-container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.25rem;
    transition: all 0.3s ease;
  }

  .arcade-container:fullscreen,
  .arcade-container:-webkit-full-screen {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    padding: 1.5rem;
    background: #0A1124;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Capa de destellos de partículas aromáticas */
  .transition-fx-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 100;
    overflow: hidden;
  }

  :global(.fx-mist-dot) {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #D4AF37;
    box-shadow: 0 0 0 3px rgba(224, 169, 139, 0.45);
    animation: mistBurst 0.65s steps(6) forwards;
  }

  @keyframes mistBurst {
    0% {
      opacity: 1;
      transform: translate(0, 0) scale(0.7);
    }
    100% {
      opacity: 0;
      transform: translate(var(--tx, 0px), var(--ty, -60px)) scale(1.6);
    }
  }

  /* ==================== BARRA SUPERIOR DEL ARCADE ==================== */
  .arcade-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 20px;
    background: rgba(14, 23, 48, 0.9);
    border: 2px solid rgba(212, 175, 55, 0.35);
    border-radius: 8px;
    backdrop-filter: blur(10px);
    margin-bottom: 20px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .arcade-brand-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #F6EFE6;
  }

  .qm-tag {
    background: #D4AF37;
    color: #0A1124;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 4px;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.35);
  }

  .arcade-topbar-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Píldora de Jugador Activo */
  .user-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(22, 38, 76, 0.85);
    border: 2px solid #E0A98B;
    border-radius: 6px;
    color: #F6EFE6;
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.25);
    transition: all 0.18s ease;
  }

  .user-pill-btn:hover {
    background: rgba(224, 169, 139, 0.25);
    border-color: #D4AF37;
    transform: translateY(-2px);
  }

  .user-avatar-mini {
    font-size: 16px;
  }

  .user-edit-hint {
    color: #D4AF37;
    font-size: 13px;
    margin-left: 2px;
  }

  /* Botones Pixel */
  :global(.btn-pixel) {
    appearance: none;
    border: 2px solid #D4AF37;
    background: rgba(14, 23, 48, 0.95);
    color: #F6EFE6;
    padding: 9px 15px;
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.3);
    transition: all 0.16s ease;
  }

  :global(.btn-pixel:hover) {
    background: #D4AF37;
    color: #0A1124;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.4);
  }

  :global(.btn-pixel:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.2);
  }

  :global(.btn-audio-toggle) {
    background: rgba(22, 38, 76, 0.7);
    border-color: #48C78E;
  }

  :global(.btn-fullscreen-toggle) {
    background: rgba(22, 38, 76, 0.7);
    border-color: #6ADCF0;
  }

  :global(.btn-back-menu) {
    background: #16264C;
    border-color: #E0A98B;
    color: #F6EFE6;
  }

  :global(.btn-back-menu:hover) {
    background: #E0A98B;
    color: #0A1124;
  }

  :global(.btn-primary-pixel) {
    background: #16264C;
    color: #F6EFE6;
    border: 3px solid #D4AF37;
    padding: 13px 26px;
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    cursor: pointer;
    border-radius: 6px;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
    transition: all 0.18s ease;
  }

  :global(.btn-primary-pixel:hover) {
    background: #D4AF37;
    color: #0A1124;
    transform: translate(-2px, -2px);
  }

  /* ==================== CONTENEDOR PRINCIPAL DEL JUEGO ==================== */
  .arcade-screen {
    min-height: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
  }

  .arcade-loading-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
    font-family: var(--font-pixel, "Silkscreen", monospace);
  }

  .loading-spinner {
    font-size: 2rem;
    color: #D4AF37;
    display: block;
    margin-bottom: 1rem;
    animation: spinSlow 3s linear infinite;
  }

  @keyframes spinSlow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* ==================== BARRA INFERIOR DE ATAJOS ==================== */
  .arcade-bottom-hints {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(212, 175, 55, 0.2);
    text-align: center;
  }

  .shortcuts-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hint-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #C0C8DA;
    background: rgba(14, 23, 48, 0.6);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hint-pill span {
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-weight: 700;
    color: #D4AF37;
    background: rgba(212, 175, 55, 0.15);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
  }

  /* Animaciones de cambio de pantalla */
  :global(.anim-screen-enter) {
    animation: screenSlideZoomIn 0.45s cubic-bezier(0.22, 0.85, 0.25, 1) forwards;
  }

  :global(.anim-screen-exit) {
    animation: screenSlideZoomOut 0.3s cubic-bezier(0.6, 0, 0.8, 0.3) forwards;
    pointer-events: none;
  }

  :global(.anim-game-launch) {
    animation: gameModeLaunch 0.4s cubic-bezier(0.22, 0.9, 0.25, 1) forwards;
    pointer-events: none;
  }

  @keyframes screenSlideZoomIn {
    0% {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
      filter: blur(2px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes screenSlideZoomOut {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(-20px) scale(0.97);
    }
  }

  @keyframes gameModeLaunch {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.06);
      filter: brightness(1.2);
    }
    100% {
      opacity: 0;
      transform: scale(1.18);
    }
  }

  /* ==================== CARRUSEL 3D ==================== */
  :global(.carousel-header-text) {
    text-align: center;
    margin-bottom: 16px;
  }

  :global(.carousel-header-text .eyebrow-tag) {
    color: #E0A98B;
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  :global(.carousel-header-text h2) {
    font-family: var(--font-display, "Cinzel", serif);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: #F6EFE6;
    margin: 4px 0 0;
  }

  :global(.carousel-3d-viewport) {
    position: relative;
    width: min(420px, 86vw);
    height: 460px;
    perspective: 1200px;
    margin: 12px auto 24px;
  }

  :global(.c-card) {
    position: absolute;
    inset: 0;
    border: 3px solid;
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    transition: transform 0.55s cubic-bezier(0.22, 0.8, 0.2, 1), opacity 0.45s ease, box-shadow 0.45s ease;
    user-select: none;
  }

  :global(.c-card.is-center) {
    animation: cardFloatIdle 3.2s ease-in-out infinite alternate;
  }

  @keyframes cardFloatIdle {
    0% { box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35); }
    100% { box-shadow: 0 24px 50px rgba(212, 175, 55, 0.35); }
  }

  :global(.c-card[data-game="snake"]) {
    background: linear-gradient(165deg, #102621 0%, #183830 100%);
    border-color: #68D3B0;
    color: #EBFBF5;
  }

  :global(.c-card[data-game="flappy"]) {
    background: linear-gradient(165deg, #231C38 0%, #342A52 100%);
    border-color: #F0B8C1;
    color: #FDF2F4;
  }

  :global(.c-card[data-game="memorama"]) {
    background: linear-gradient(165deg, #141F36 0%, #1D2E4E 100%);
    border-color: #E0BE74;
    color: #F8F3EB;
  }

  :global(.c-card[data-game="reflejos"]) {
    background: linear-gradient(165deg, #0F2232 0%, #16334A 100%);
    border-color: #6ADCF0;
    color: #ECFBFF;
  }

  :global(.c-card-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  :global(.c-card-art) {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 2px dashed rgba(255, 255, 255, 0.22);
    border-radius: 6px;
  }

  :global(.c-card-body h3) {
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 18px;
    margin: 10px 0 6px;
    color: #FFFFFF;
  }

  :global(.c-card-body p) {
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 14px;
    line-height: 1.35;
    margin: 0;
    opacity: 0.92;
  }

  :global(.c-card-cta) {
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.35);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.18s ease, color 0.18s ease;
  }

  :global(.c-card.is-center .c-card-cta:hover) {
    background: #D4AF37;
    color: #0A1124;
    border-color: #D4AF37;
  }

  :global(.carousel-nav) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 8px;
  }

  :global(#c-indicator) {
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #D4AF37;
  }

  /* ==================== SELECTOR DE MAPAS MESOAMERICANOS ==================== */
  :global(.map-selector-bar) {
    width: 100%;
    max-width: 860px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    background: rgba(10, 17, 36, 0.85);
    border: 2px solid rgba(212, 175, 55, 0.4);
    border-radius: 6px;
    padding: 10px 16px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
  }

  :global(.map-selector-label) {
    font-family: var(--font-pixel, "Silkscreen", monospace);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: #F4DFAC;
    font-weight: 700;
  }

  :global(.map-pills-row) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.map-pill) {
    appearance: none;
