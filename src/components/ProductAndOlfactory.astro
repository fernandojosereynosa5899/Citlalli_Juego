---
/**
 * CITLALLI — ProductAndOlfactory.astro
 * Galería Interactiva del Producto (Envase, Empaque de Terciopelo, Logotipo, Moodboard,
 * Etiqueta Trasera e Instructivo de Puntos de Pulso) + Pirámide Olfativa y Laboratorio Alquímico.
 */
export interface Props {
  showProductOnly?: boolean;
  showOlfactoryOnly?: boolean;
}

const { showProductOnly = false, showOlfactoryOnly = false } = Astro.props;
---

{
  !showOlfactoryOnly && (
    <section id="producto" class={`product-section ${showProductOnly ? 'product-only' : ''}`}>
      <div class="section-container">
        <!-- Encabezado de Diseño de Producto -->
        <div class="section-header">
      <span class="section-kicker">
        <span>💎</span> BOCETO Y ANATOMÍA DE ALTA PERFUMERÍA
      </span>
      <h2 class="section-title">
        Ingeniería del Lujo: <span class="gold-accent">Frasco, Terciopelo & Identidad</span>
      </h2>
      <p class="section-subtitle">
        Cada ángulo del cristal facetado, el medallón “QM” en oro rosa y la caja en terciopelo azul
        marino han sido concebidos para custodiar “El Aroma de los Dioses”.
      </p>
    </div>

    <!-- Selector de Pestañas del Producto -->
    <div class="product-tabs-bar" role="tablist" aria-label="Componentes del Producto Citlalli">
      <button
        type="button"
        class="prod-tab-btn active"
        data-prod-tab="envase"
        role="tab"
        aria-selected="true"
      >
        <span>🧴</span> 1. El Envase & Dije QM
      </button>
      <button
        type="button"
        class="prod-tab-btn"
        data-prod-tab="empaque"
        role="tab"
        aria-selected="false"
      >
        <span>🎁</span> 2. Empaque Terciopelo
      </button>
      <button
        type="button"
        class="prod-tab-btn"
        data-prod-tab="identidad"
        role="tab"
        aria-selected="false"
      >
        <span>⭐</span> 3. Logotipo & Moodboard
      </button>
      <button
        type="button"
        class="prod-tab-btn"
        data-prod-tab="etiqueta"
        role="tab"
        aria-selected="false"
      >
        <span>📜</span> 4. Etiqueta & Ritual de Pulso
      </button>
    </div>

    <!-- Paneles del Showcase de Producto -->
    <div class="product-showcase-stage">
      <!-- TAB 1: EL ENVASE -->
      <div class="prod-tab-panel active" data-prod-panel="envase">
        <div class="prod-panel-grid">
          <div class="prod-image-frame">
            <img
              src="/assets/brand/bottle.png"
              alt="Frasco CITLALLI de cristal grueso facetado con tapa oro rosa y dije QM"
              class="prod-featured-img"
              loading="lazy"
            />
            <span class="prod-frame-badge">CRISTAL FACETADO • 50 ML (1.7 FL. OZ.)</span>
          </div>
          <div class="prod-specs-content">
            <span class="spec-kicker">DISEÑO INDUSTRIAL & JOYERÍA OLFATIVA</span>
            <h3>El Frasco Facetado CITLALLI</h3>
            <p>
              Tallado como un prisma estelar en <strong>cristal grueso de alta pureza</strong>, el
              envase permite admirar la calidez del líquido color <strong>melocotón / ámbar
              dorado</strong> que refleja la luz como una estrella al amanecer.
            </p>
            <div class="spec-feature-list">
              <div class="spec-item">
                <span class="spec-icon">👑</span>
                <div>
                  <strong>Tapón Geométrico en Oro Rosa</strong>
                  <p>Acabado metálico espejado con facetas octogonales inspiradas en la estrella de 8 puntas.</p>
                </div>
              </div>
              <div class="spec-item">
                <span class="spec-icon">🪙</span>
                <div>
                  <strong>Colgante Redondo “QM”</strong>
                  <p>Medallón exclusivo en oro rosa suspendido del cuello del atomizador, sello de autenticidad y distinción.</p>
                </div>
              </div>
              <div class="spec-item">
                <span class="spec-icon">✨</span>
                <div>
                  <strong>Placa Frontal Grabada</strong>
                  <p>Tipografía serif imperial <em>CITLALLI Eau de Parfum</em> enmarcada en baño dorado.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 2: EL EMPAQUE -->
      <div class="prod-tab-panel" data-prod-panel="empaque">
        <div class="prod-panel-grid">
          <div class="prod-image-frame">
            <img
              src="/assets/brand/box.png"
              alt="Caja de terciopelo azul marino CITLALLI con letras doradas y cinta superior"
              class="prod-featured-img"
              loading="lazy"
            />
            <span class="prod-frame-badge">TERCIOPELO AZUL MARINO • HOT STAMPING ORO</span>
          </div>
          <div class="prod-specs-content">
            <span class="spec-kicker">EXPERIENCIA DE UNBOXING SENSORIAL</span>
            <h3>Empaque en Terciopelo Azul Marino Nocturno</h3>
            <p>
              El estuche exterior evoca la profundidad del cielo nocturno de Hidalgo mediante un
              recubrimiento de <strong>terciopelo azul marino (`#0A1124`)</strong> suave al tacto,
              contrastado con relieves geométricos en <strong>oro metálico (`#D4AF37`)</strong>.
            </p>
            <div class="spec-feature-list">
              <div class="spec-item">
                <span class="spec-icon">🌌</span>
                <div>
                  <strong>Textura Velvet Midnight</strong>
                  <p>Protege la fragancia de la luz directa mientras brinda una sensación táctil de alta joyería.</p>
                </div>
              </div>
              <div class="spec-item">
                <span class="spec-icon">🎀</span>
                <div>
                  <strong>Cinta Superior y Patrones Astrales</strong>
                  <p>Lazo de seda azul marino en la corona del estuche y grecas estelares doradas en cada arista.</p>
                </div>
              </div>
              <div class="spec-item">
                <span class="spec-icon">🛡️</span>
                <div>
                  <strong>Cuna Interior Acolchada</strong>
                  <p>Diseñada a medida para mantener inmóvil el cristal facetado de 50 ml.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: LOGOTIPO Y MOODBOARD -->
      <div class="prod-tab-panel" data-prod-panel="identidad">
        <div class="prod-dual-grid">
          <div class="prod-card-half">
            <div class="prod-image-frame compact">
              <img
                src="/assets/brand/logo.png"
                alt="Logotipo Oficial CITLALLI El Aroma de los Dioses"
                class="prod-featured-img"
                loading="lazy"
              />
            </div>
            <div class="prod-card-body">
              <span class="spec-kicker">IDENTIDAD VISUAL</span>
              <h4>Logotipo Imperial & Estrella de 8 Puntas</h4>
              <p>
                Fusiona la estrella cósmica de ocho puntas con la silueta del frasco real y el
                lema <em>“CITLALLI — El Aroma de los Dioses”</em> en oro sobre azul profundo.
              </p>
            </div>
          </div>

          <div class="prod-card-half">
            <div class="prod-image-frame compact">
              <img
                src="/assets/brand/moodboard.png"
                alt="Moodboard Oficial CITLALLI"
                class="prod-featured-img"
                loading="lazy"
              />
            </div>
            <div class="prod-card-body">
              <span class="spec-kicker">DIRECCIÓN DE ARTE</span>
              <h4>Moodboard Conceptual de Marca</h4>
              <p>
                Inspiración estética que une la bóveda celeste, el oro rosa, las flores bañadas en
                rocío, la arquitectura nocturna y el magnetismo contemporáneo.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 4: ETIQUETA E INSTRUCTIVO DE PUNTOS DE PULSO -->
      <div class="prod-tab-panel" data-prod-panel="etiqueta">
        <div class="prod-dual-grid">
          <div class="prod-card-half">
            <div class="prod-image-frame compact">
              <img
                src="/assets/brand/label_back.png"
                alt="Etiqueta trasera oficial CITLALLI 50 ML Hecho en México"
                class="prod-featured-img"
                loading="lazy"
              />
            </div>
            <div class="prod-card-body">
              <span class="spec-kicker">NORMATIVA Y ORIGEN</span>
              <h4>Etiqueta Oficial (50 ML / 1.7 FL. OZ.)</h4>
              <p>
                Certificación de <strong>Eau de Parfum Hecho en México</strong>, ingredientes
                selectos, lote de destilación artesanal, código de barras y sellos de calidad.
              </p>
            </div>
          </div>

          <div class="prod-card-half">
            <div class="prod-image-frame compact">
              <img
                src="/assets/brand/instructions_card.png"
                alt="Instructivo de uso de CITLALLI en puntos de pulso"
                class="prod-featured-img"
                loading="lazy"
              />
            </div>
            <div class="prod-card-body">
              <span class="spec-kicker">RITUAL DE APLICACIÓN</span>
              <h4>Instructivo Oficial: Puntos de Pulso</h4>
              <p>
                Aplicar a 15 cm sobre la <strong>piel limpia e hidratada</strong> en las zonas de
                mayor calor corporal: <strong>muñecas, detrás de las orejas y base del cuello</strong>
                sin frotar, para preservar las notas de salida.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
  )
}

{
  !showProductOnly && (
    <section id="alquimia" class={`product-section olfactory-section ${showOlfactoryOnly ? 'olfactory-only' : ''}`}>
      <div class="section-container">
        <!-- =================================================================== -->
        <!-- PIRÁMIDE OLFATIVA INTERACTIVA & LABORATORIO ALQUÍMICO (#alquimia)   -->
        <!-- =================================================================== -->
        <div class="section-header">
        <span class="section-kicker">
          <span>🏺</span> COMPOSICIÓN AROMÁTICA & ALQUIMIA INTERACTIVA
        </span>
        <h2 class="section-title">
          Pirámide Olfativa y <span class="gold-accent">Laboratorio de Esencias</span>
        </h2>
        <p class="section-subtitle">
          Explora las tres capas aromáticas de CITLALLI y mezcla tu propia proporción en la vasija
          de David para desbloquear tu Arquetipo Estelar y encontrar tu armonía olfativa perfecta.
        </p>
      </div>

      <!-- Tarjetas Visuales de las Notas en Terciopelo -->
      <div class="velvet-notes-gallery">
        <div class="velvet-photo-card">
          <img
            src="/assets/brand/notes_velvet_1.png"
            alt="Composición de notas olfativas Citlalli sobre terciopelo azul marino 1"
            loading="lazy"
          />
          <div class="velvet-photo-caption">
            <strong>Bodegón Olfativo I</strong>
            <span>Mandarina, Rosas Rosadas, Jazmín y Vainilla junto al Frasco QM</span>
          </div>
        </div>

        <div class="velvet-photo-card">
          <img
            src="/assets/brand/notes_velvet_2.png"
            alt="Composición de notas olfativas Citlalli sobre terciopelo azul marino 2"
            loading="lazy"
          />
          <div class="velvet-photo-caption">
            <strong>Bodegón Olfativo II</strong>
            <span>Resina de Ámbar Dorado, Pétalos Frescos y Textura de Terciopelo</span>
          </div>
        </div>
      </div>

      <div class="alchemy-grid">
        <!-- Columna Izquierda: Pirámide Olfativa de 3 Niveles -->
        <div class="pyramid-column">
          <h3 class="pyramid-heading">✦ La Pirámide Olfativa de CITLALLI</h3>

          <div class="pyramid-tier tier-top" data-tier="top">
            <div class="tier-badge">1. NOTAS DE SALIDA (PRIMER IMPACTO • 0–15 MIN)</div>
            <div class="tier-content">
              <div class="tier-sprites">
                <img src="/assets/pixel-art/sprites/mandarin.png" alt="Mandarina" width="42" height="42" />
              </div>
              <div>
                <h4>Mandarina Fresca & Bergamota Cítrica</h4>
                <p>
                  Una apertura luminosa, jugosa y chispeante que despierta los sentidos al instante
                  como el rocío matutino sobre los huertos de Hidalgo.
                </p>
              </div>
            </div>
          </div>

          <div class="pyramid-tier tier-heart" data-tier="heart">
            <div class="tier-badge">2. NOTAS DE CORAZÓN (ALMA DEL PERFUME • 15 MIN–4 HRS)</div>
            <div class="tier-content">
              <div class="tier-sprites">
                <img src="/assets/pixel-art/sprites/rose_pink.png" alt="Rosa Rosada" width="42" height="42" />
                <img src="/assets/pixel-art/sprites/jasmine_white.png" alt="Jazmín Blanco" width="42" height="42" />
              </div>
              <div>
                <h4>Rosas Rosadas & Jazmín Blanco Nocturno</h4>
                <p>
                  El corazón floral aterciopelado que equilibra sofisticación, magnetismo romántico
                  y elegancia de gala.
                </p>
              </div>
            </div>
          </div>

          <div class="pyramid-tier tier-base" data-tier="base">
            <div class="tier-badge">3. NOTAS DE FONDO (ESTELA ETERNA • 4–12+ HRS)</div>
            <div class="tier-content">
              <div class="tier-sprites">
                <img src="/assets/pixel-art/sprites/vanilla_pod.png" alt="Vainilla" width="42" height="42" />
                <img src="/assets/pixel-art/sprites/amber_crystal.png" alt="Ámbar Dorado" width="42" height="42" />
              </div>
              <div>
                <h4>Vainas de Vainilla Pura & Resina de Ámbar Dorado</h4>
                <p>
                  El sello místico y seductor que se funde con la piel, dejando una huella cálida,
                  poderosa e inolvidable digna de los dioses.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Laboratorio Alquímico Interactivo ("Destila tu Esencia") -->
        <div class="alchemist-lab-card">
          <div class="lab-header">
            <img
              src="/assets/pixel-art/sprites/clay_vessel.png"
              alt="Vasija de Barro de David"
              class="lab-vessel-icon"
              width="48"
              height="48"
            />
            <div>
              <span class="spec-kicker">RITUAL INTERACTIVO DE ALTA PERFUMERÍA</span>
              <h3>Laboratorio Alquímico: “Destila tu Esencia”</h3>
            </div>
          </div>

          <p class="lab-intro">
            Ajusta la proporción de cada nota en la vasija de David para descubrir tu
            <strong>Arquetipo Citlalli</strong> y revelar la estela aromática sagrada que resuena con tu esencia.
          </p>

          <div class="sliders-container">
            <div class="alchemy-slider-row">
              <div class="slider-label-row">
                <span>🍊 Salida (Mandarina & Bergamota)</span>
                <strong id="val-top-note">35%</strong>
              </div>
              <input
                type="range"
                id="slider-top-note"
                min="10"
                max="80"
                value="35"
                class="lux-range range-mandarin"
              />
            </div>

            <div class="alchemy-slider-row">
              <div class="slider-label-row">
                <span>🌹 Corazón (Rosa Rosada & Jazmín)</span>
                <strong id="val-heart-note">35%</strong>
              </div>
              <input
                type="range"
                id="slider-heart-note"
                min="10"
                max="80"
                value="35"
                class="lux-range range-rose"
              />
            </div>

            <div class="alchemy-slider-row">
              <div class="slider-label-row">
                <span>✨ Fondo (Vainilla & Resina de Ámbar)</span>
                <strong id="val-base-note">30%</strong>
              </div>
              <input
                type="range"
                id="slider-base-note"
                min="10"
                max="80"
                value="30"
                class="lux-range range-amber"
              />
            </div>
          </div>

          <!-- Resultado de la Destilación -->
          <div class="alchemy-result-box" id="alchemy-result-box">
            <div class="result-header">
              <span class="result-kicker">ARQUETIPO DESTILADO</span>
              <span class="bonus-pill" id="alchemy-bonus-status">Bono +100 PTS Listo</span>
            </div>
            <h4 id="alchemy-archetype-title">Equilibrio Imperial Citlalli</h4>
            <p id="alchemy-archetype-desc">
              Armonía perfecta entre la frescura cítrica de Hidalgo, el corazón floral de terciopelo
              y el fondo místico del Jaguar Dorado.
            </p>
          </div>

          <div class="lab-actions">
            <button type="button" id="btn-distill-essence" class="btn-distill">
              <span>⚗️</span>
              <span>Destilar Esencia & Reclamar +100 PTS</span>
            </button>
            <button type="button" id="btn-toggle-gold-theme" class="btn-gold-theme">
              <span>👑</span>
              <span>Alternar Tema Alquímico</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
)
}

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Pestañas del Producto
    const prodTabs = document.querySelectorAll('.prod-tab-btn');
    const prodPanels = document.querySelectorAll('.prod-tab-panel');

    prodTabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-prod-tab');
        prodTabs.forEach((b) => {
          b.classList.toggle('active', b === btn);
          b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
        });
        prodPanels.forEach((p) => {
          p.classList.toggle('active', p.getAttribute('data-prod-panel') === target);
        });
      });
    });

    // 2. Laboratorio Alquímico Interactivo
    const sTop = document.getElementById('slider-top-note');
    const sHeart = document.getElementById('slider-heart-note');
    const sBase = document.getElementById('slider-base-note');
    const vTop = document.getElementById('val-top-note');
    const vHeart = document.getElementById('val-heart-note');
    const vBase = document.getElementById('val-base-note');
    const titleEl = document.getElementById('alchemy-archetype-title');
    const descEl = document.getElementById('alchemy-archetype-desc');
    const bonusEl = document.getElementById('alchemy-bonus-status');
    const distillBtn = document.getElementById('btn-distill-essence');
    const themeBtn = document.getElementById('btn-toggle-gold-theme');

    function computeArchetype() {
      const top = Number(sTop?.value || 35);
      const heart = Number(sHeart?.value || 35);
      const base = Number(sBase?.value || 30);
      const sum = Math.max(1, top + heart + base);

      const pTop = Math.round((top / sum) * 100);
      const pHeart = Math.round((heart / sum) * 100);
      const pBase = Math.max(0, 100 - pTop - pHeart);

      if (vTop) vTop.textContent = `${pTop}%`;
      if (vHeart) vHeart.textContent = `${pHeart}%`;
      if (vBase) vBase.textContent = `${pBase}%`;

      let archetype = 'Equilibrio Imperial Citlalli';
      let desc =
        'Armonía exacta entre el rocío cítrico de Hidalgo, el terciopelo floral y la fuerza dorada del ámbar.';

      if (pTop >= 44) {
        archetype = 'Estrella Cítrica de Hidalgo';
        desc =
          'Dominado por la mandarina fresca y la bergamota: energía solar, dinamismo juvenil y frescura luminosa.';
      } else if (pHeart >= 44) {
        archetype = 'Alquimista de Terciopelo Rosa';
        desc =
          'Dominado por rosas rosadas y jazmín blanco: magnetismo romántico, sofisticación de gala y elegancia pura.';
      } else if (pBase >= 42) {
        archetype = 'Caballero del Jaguar de Ámbar';
        desc =
          'Dominado por vainilla pura y resina de ámbar dorado: presencia nocturna imponente, misterio y fijación legendaria.';
      }

      if (titleEl) titleEl.textContent = archetype;
      if (descEl) descEl.textContent = desc;
      return { archetype, desc, pTop, pHeart, pBase };
    }

    [sTop, sHeart, sBase].forEach((slider) => {
      if (slider) slider.addEventListener('input', computeArchetype);
    });

    if (distillBtn) {
      distillBtn.addEventListener('click', (e) => {
        const { archetype } = computeArchetype();
        const rect = distillBtn.getBoundingClientRect();
        if (typeof window.triggerCitlalliAtomizer === 'function') {
          window.triggerCitlalliAtomizer(rect.left + rect.width / 2, rect.top, false);
        }

        if (window.CitlalliMultiplayer) {
          window.CitlalliMultiplayer.setAlchemyBonus(100, archetype);
        }

        if (bonusEl) {
          bonusEl.textContent = '✓ +100 PTS ACTIVADOS';
          bonusEl.classList.add('claimed');
        }

        if (typeof window.showCitlalliToast === 'function') {
          window.showCitlalliToast({
            title: `ESENCIA DESTILADA: ${archetype.toUpperCase()}`,
            message:
              '¡Has desbloqueado la estrella "Alquimista de Hidalgo" y +100 puntos de bono para la Copa Citlalli!',
            icon: '🏺',
            type: 'gold',
            duration: 5000
          });
        }
      });
    }

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        document.body.classList.toggle('gold-alchemist-theme');
        const active = document.body.classList.contains('gold-alchemist-theme');
        if (typeof window.showCitlalliToast === 'function') {
          window.showCitlalliToast({
            title: active ? 'TEMA ALQUÍMICO DORADO ACTIVADO' : 'TEMA TERCIOPELO NOCTURNO ACTIVADO',
            message: active
              ? 'El resplandor del oro imperial ilumina la interfaz de CITLALLI.'
              : 'Has vuelto al azul marino terciopelo original de CITLALLI.',
            icon: '👑',
            type: 'gold',
            duration: 3200
          });
        }
      });
    }
  });
</script>

<style>
  .product-section {
    padding: 5.5rem 0;
  }

  .product-tabs-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
  }

  .prod-tab-btn {
    background: rgba(14, 23, 48, 0.85);
    color: var(--cream-silk);
    border: 1.5px solid rgba(212, 175, 55, 0.3);
    padding: 0.8rem 1.35rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.25s ease;
  }

  .prod-tab-btn:hover {
    border-color: var(--rose-gold);
    transform: translateY(-2px);
  }

  .prod-tab-btn.active {
    background: linear-gradient(135deg, var(--gold-metallic), var(--rose-gold));
    color: var(--navy-deep);
    border-color: var(--gold-bright);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.35);
  }

  .product-showcase-stage {
    margin-bottom: 5.5rem;
  }

  .product-section.product-only .product-showcase-stage {
    margin-bottom: 0;
  }

  .prod-tab-panel {
    display: none;
    animation: fadeProd 0.35s ease;
  }

  .prod-tab-panel.active {
    display: block;
  }

  @keyframes fadeProd {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
