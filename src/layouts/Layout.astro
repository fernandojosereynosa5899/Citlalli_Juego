---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CITLALLI — El Aroma de los Dioses | Eau de Parfum & Salón Arcade Pixel Art",
  description = "Sitio Oficial de CITLALLI Eau de Parfum (50 ml). El límite son las estrellas, el aroma de los dioses. Descubre el storytelling de David en Hidalgo, la pirámide olfativa, la campaña del Jaguar Dorado y juega en el Salón Arcade Pixel Art con Multijugador Simultáneo."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A1124" />
    <link rel="icon" type="image/png" href="/assets/brand/emblem_cosmic.png" />

    <!-- Google Fonts: Cinzel, Cormorant Garamond, Plus Jakarta Sans & Press Start 2P -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Lienzo global de cosmos, estrellas de Hidalgo y partículas interactivas de perfume -->
    <canvas id="citlalli-global-canvas" aria-hidden="true"></canvas>

    <!-- Contenedor de notificaciones flotantes (Logros, Notas Olfativas y Emotes) -->
    <div id="citlalli-toast-stack" class="toast-stack" aria-live="polite"></div>

    <!-- Cabecera Modular Estilo volantes_economicos -->
    <Header currentPath={Astro.url.pathname} />

    <!-- Contenido Principal -->
    <main id="contenido-principal">
      <slot />
    </main>

    <!-- Pie de Página Modular Estilo volantes_economicos -->
    <Footer />

    <!-- Script Global de Cosmos, Atomizador de Perfume y Notificaciones -->
    <script is:inline>
      (function () {
        const canvas = document.getElementById('citlalli-global-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        window.addEventListener('resize', () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        const stars = Array.from({ length: 85 }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() * 1.6 + 0.4,
          alpha: Math.random() * 0.7 + 0.2,
          speed: Math.random() * 0.02 + 0.005,
          phase: Math.random() * Math.PI * 2,
          color:
            Math.random() > 0.65
              ? '#FFE57F'
              : Math.random() > 0.4
              ? '#E0A98B'
              : '#F6EFE6'
        }));

        const mistParticles = [];

        const OLFACTORY_QUOTES = [
          '🍊 Nota de Salida: Mandarina fresca y bergamota cítrica iluminan el aire nocturno.',
          '🌹 Nota de Corazón: Rosas rosadas y jazmín blanco despiertan la elegancia del terciopelo.',
          '✨ Nota de Fondo: Vainas de vainilla pura y resina de ámbar dorado sellan el Aroma de los Dioses.',
          '🐆 Esencia Citlalli: “El límite son las estrellas — El aroma de los dioses”.',
          '🌌 Brisa de Hidalgo: Rocío matutino destilado artesanalmente bajo un manto estelar.'
        ];

        window.showCitlalliToast = function ({
          title = 'CITLALLI',
          message = '',
          icon = '✨',
          type = 'gold',
          duration = 4200
        } = {}) {
          const stack = document.getElementById('citlalli-toast-stack');
          if (!stack) return;
          const toast = document.createElement('div');
          toast.className = `citlalli-toast toast-${type}`;
          toast.innerHTML = `
            <div class="toast-icon">${icon}</div>
            <div class="toast-content">
              <div class="toast-title">${title}</div>
              <div class="toast-msg">${message}</div>
            </div>
          `;
          stack.appendChild(toast);
          requestAnimationFrame(() => toast.classList.add('visible'));
          setTimeout(() => {
            toast.classList.remove('visible');
            setTimeout(() => toast.remove(), 350);
          }, duration);
        };

        window.triggerCitlalliAtomizer = function (originX, originY, showNote = true) {
          const cx = typeof originX === 'number' ? originX : width * 0.5;
          const cy = typeof originY === 'number' ? originY : height * 0.42;

          const palette = ['#D4AF37', '#E0A98B', '#FFE57F', '#FF9E6D', '#FFF6E5', '#F7B2D9'];
          for (let i = 0; i < 120; i++) {
            const angle = Math.random() * Math.PI * 2;
            const speed = Math.random() * 8.5 + 1.2;
            mistParticles.push({
              x: cx,
              y: cy,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed - Math.random() * 2.2,
              r: Math.random() * 3.8 + 1.2,
              alpha: 1,
              decay: Math.random() * 0.012 + 0.006,
              color: palette[Math.floor(Math.random() * palette.length)]
            });
          }

          // Reproducir sonido de atomizador o acorde místico
          if (window.CitlalliAudio) {
            try {
              if (typeof window.CitlalliAudio.playSFX === 'function') {
                window.CitlalliAudio.playSFX('powerup');
              } else if (typeof window.CitlalliAudio.play === 'function') {
                window.CitlalliAudio.play('powerup');
              }
            } catch (_) {}
          } else {
            try {
              const AudioCtx = window.AudioContext || window.webkitAudioContext;
              if (AudioCtx) {
                const actx = new AudioCtx();
                // Ruido blanco suave de atomizador + acorde cristalino
                const bufferSize = actx.sampleRate * 0.28;
                const buffer = actx.createBuffer(1, bufferSize, actx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                  data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (actx.sampleRate * 0.09));
                }
                const noise = actx.createBufferSource();
                noise.buffer = buffer;
                const filter = actx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.value = 3200;
                const gain = actx.createGain();
                gain.gain.value = 0.16;
                noise.connect(filter);
                filter.connect(gain);
                gain.connect(actx.destination);
                noise.start();
              }
            } catch (_) {}
          }

          if (window.CitlalliMultiplayer) {
            window.CitlalliMultiplayer.unlockAchievement('first_spray');
          }

          if (showNote) {
            const quote = OLFACTORY_QUOTES[Math.floor(Math.random() * OLFACTORY_QUOTES.length)];
            window.showCitlalliToast({
              title: 'ATOMIZADOR SENSORIAL CITLALLI',
              message: quote,
              icon: '🧴',
              type: 'rosegold',
              duration: 4500
            });
          }
        };

        // Botón del navbar para atomizar y menú móvil
        document.addEventListener('DOMContentLoaded', () => {
          const navSprayBtn = document.getElementById('nav-spray-btn');
          if (navSprayBtn) {
            navSprayBtn.addEventListener('click', (e) => {
              const rect = navSprayBtn.getBoundingClientRect();
              window.triggerCitlalliAtomizer(rect.left + rect.width / 2, rect.bottom + 10, true);
            });
          }

          // Alternar menú desplegable móvil
          const mobileMenuBtn = document.getElementById('mobile-menu-btn');
          const mobileNavDrawer = document.getElementById('mobile-nav-drawer');
          if (mobileMenuBtn && mobileNavDrawer) {
            mobileMenuBtn.addEventListener('click', () => {
              const isOpen = mobileNavDrawer.classList.toggle('open');
              mobileMenuBtn.classList.toggle('active', isOpen);
              mobileMenuBtn.setAttribute('aria-expanded', isOpen);
              mobileNavDrawer.setAttribute('aria-hidden', !isOpen);
            });

            // Cerrar menú al hacer clic en cualquier enlace
            mobileNavDrawer.querySelectorAll('.mobile-nav-link').forEach((link) => {
              link.addEventListener('click', () => {
                mobileNavDrawer.classList.remove('open');
                mobileMenuBtn.classList.remove('active');
                mobileMenuBtn.setAttribute('aria-expanded', 'false');
                mobileNavDrawer.setAttribute('aria-hidden', 'true');
              });
            });
          }
        });

        // Estela sutil con el cursor
        let lastMouseTime = 0;
        window.addEventListener('pointermove', (e) => {
          const now = performance.now();
          if (now - lastMouseTime < 45) return;
          lastMouseTime = now;
          if (mistParticles.length < 180) {
            mistParticles.push({
              x: e.clientX,
              y: e.clientY,
              vx: (Math.random() - 0.5) * 0.9,
              vy: -Math.random() * 0.8 - 0.2,
              r: Math.random() * 2 + 0.8,
              alpha: 0.65,
              decay: 0.022,
              color: Math.random() > 0.5 ? '#D4AF37' : '#E0A98B'
            });
          }
        });

        function renderLoop(now) {
          ctx.clearRect(0, 0, width, height);

          for (const st of stars) {
            const twinkle = 0.35 + 0.65 * Math.abs(Math.sin(now * 0.0015 + st.phase));
            ctx.globalAlpha = st.alpha * twinkle;
            ctx.fillStyle = st.color;
            ctx.beginPath();
            ctx.arc(st.x, st.y, st.r, 0, Math.PI * 2);
            ctx.fill();
          }

          for (let i = mistParticles.length - 1; i >= 0; i--) {
            const p = mistParticles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vx *= 0.97;
            p.vy *= 0.97;
            p.vy -= 0.015; // Flotación ligera de bruma aromática
            p.alpha -= p.decay;

            if (p.alpha <= 0) {
              mistParticles.splice(i, 1);
              continue;
            }

            ctx.save();
            ctx.globalAlpha = p.alpha;
            ctx.fillStyle = p.color;
            ctx.shadowColor = p.color;
            ctx.shadowBlur = 8;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }

          requestAnimationFrame(renderLoop);
        }

        requestAnimationFrame(renderLoop);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --navy-deep: #050914;
    --navy-velvet: #0A1124;
    --navy-card: #101B38;
    --navy-glass: rgba(13, 22, 48, 0.78);
    --gold-metallic: #D4AF37;
    --gold-bright: #FFE57F;
    --gold-soft: #F3E5AB;
    --rose-gold: #E0A98B;
    --rose-bright: #F4C2B8;
    --cream-silk: #F6EFE6;
    --text-muted: #A9B6D3;
    --font-display: 'Cinzel', Georgia, serif;
    --font-editorial: 'Cormorant Garamond', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-pixel: 'Press Start 2P', 'Courier New', monospace;
  }

  body.gold-alchemist-theme {
    --navy-velvet: #0D1220;
    --gold-metallic: #FFD700;
    --rose-gold: #F5C396;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    background-color: var(--navy-velvet);
    color: var(--cream-silk);
    font-family: var(--font-sans);
    line-height: 1.6;
    overflow-x: hidden;
  }

  #citlalli-global-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }

  main,
  header,
  footer {
    position: relative;
    z-index: 2;
  }

  .section-container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rose-gold);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.35);
    padding: 0.4rem 1rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 700;
    color: var(--cream-silk);
    line-height: 1.18;
    margin-bottom: 1rem;
    text-shadow: 0 4px 24px rgba(212, 175, 55, 0.22);
  }

  .section-title .gold-accent {
    background: linear-gradient(135deg, var(--gold-bright), var(--gold-metallic), var(--rose-gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    font-family: var(--font-editorial);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--text-muted);
    font-style: italic;
  }

  /* Navbar */
  .luxury-navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6, 11, 24, 0.86);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(212, 175, 55, 0.28);
  }

  .nav-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--cream-silk);
  }

  .brand-emblem-img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid var(--gold-metallic);
    object-fit: cover;
    box-shadow: 0 0 14px rgba(212, 175, 55, 0.4);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.16em;
    color: var(--gold-metallic);
    line-height: 1.1;
  }

  .brand-sub {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--rose-gold);
    font-weight: 600;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .nav-link {
    color: var(--cream-silk);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link:hover {
    color: var(--gold-bright);
    transform: translateY(-1px);
  }

  .nav-link-arcade {
    color: var(--gold-bright);
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.14);
    border: 1px solid rgba(212, 175, 55, 0.45);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .btn-nav-spray {
    background: rgba(224, 169, 139, 0.15);
    color: var(--rose-bright);
    border: 1px solid var(--rose-gold);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.25s ease;
  }

  .btn-nav-spray:hover {
    background: var(--rose-gold);
    color: var(--navy-deep);
    box-shadow: 0 0 18px rgba(224, 169, 139, 0.55);
  }

  .btn-nav-arcade {
    background: linear-gradient(135deg, var(--gold-metallic), #b68b23);
    color: var(--navy-deep);
    text-decoration: none;
    padding: 0.52rem 1.05rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 0 18px rgba(212, 175, 55, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-nav-arcade:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(255, 229, 127, 0.65);
  }

  /* Toast Stack */
  .toast-stack {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 390px;
    pointer-events: none;
  }

  .citlalli-toast {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(10, 17, 36, 0.95);
    border: 1.5px solid var(--gold-metallic);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65), 0 0 20px rgba(212, 175, 55, 0.28);
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    color: var(--cream-silk);
    transform: translateX(120%);
    opacity: 0;
    transition: all 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
  }

  .citlalli-toast.visible {
    transform: translateX(0);
    opacity: 1;
  }

  .toast-icon {
    font-size: 1.65rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .toast-title {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--gold-bright);
    margin-bottom: 0.2rem;
  }

  .toast-msg {
    font-size: 0.84rem;
    color: var(--cream-silk);
    line-height: 1.4;
  }

  /* Footer */
  .luxury-footer {
    background: linear-gradient(180deg, #070C1B 0%, #040710 100%);
    padding: 4.5rem 0 2rem;
    margin-top: 5rem;
    position: relative;
  }

  .footer-glow-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--gold-metallic),
      var(--rose-gold),
      var(--gold-metallic),
      transparent
    );
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .footer-crest {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .footer-logo {
    width: 68px;
    height: 68px;
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    background: rgba(10, 17, 36, 0.8);
    padding: 4px;
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--gold-metallic);
    letter-spacing: 0.15em;
  }

  .footer-tagline {
    font-family: var(--font-editorial);
    font-style: italic;
    color: var(--rose-gold);
    font-size: 1.05rem;
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 1.25rem;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lux-badge {
    font-size: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.32);
    color: var(--gold-soft);
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--gold-bright);
    letter-spacing: 0.1em;
    margin-bottom: 1.2rem;
    text-transform: uppercase;
  }

  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-nav-list a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-nav-list a:hover {
    color: var(--gold-bright);
  }

  .academic-card {
    background: rgba(16, 27, 56, 0.75);
    border: 1px solid rgba(212, 175, 55, 0.38);
    border-radius: 16px;
    padding: 1.25rem;
  }

  .academic-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .academic-row-inline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .academic-label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--rose-gold);
    font-weight: 700;
  }

  .academic-value {
    font-size: 0.95rem;
    color: var(--cream-silk);
  }

  .academic-badge {
    display: inline-block;
    margin-top: 0.2rem;
    background: linear-gradient(135deg, var(--gold-metallic), var(--rose-gold));
    color: var(--navy-deep);
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
  }

  .academic-divider {
    height: 1px;
    background: rgba(212, 175, 55, 0.2);
    margin: 0.8rem 0;
  }

  .footer-bottom {
    border-top: 1px solid rgba(212, 175, 55, 0.15);
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Botón Hamburguesa Móvil */
  .btn-mobile-menu {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 38px;
    height: 38px;
    background: rgba(16, 27, 56, 0.7);
    border: 1.5px solid var(--gold-metallic);
    border-radius: 9px;
    padding: 8px 7px;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.2);
    transition: all 0.2s ease;
  }

  .btn-mobile-menu:hover {
    background: rgba(212, 175, 55, 0.2);
    border-color: var(--gold-bright);
  }

